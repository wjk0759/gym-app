# ---- MySQL ----
MYSQL_DATABASE=fitai
MYSQL_USER=fitai
MYSQL_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# ---- Admin server ----
# Required. Generate with: openssl rand -base64 64
FITAI_JWT_SECRET=
FITAI_COOKIE_SECURE=false
FITAI_COOKIE_SAME_SITE=Strict
FITAI_CORS_ORIGINS=http://localhost:8088

# First boot only. Set to false after the initial administrator is created.
FITAI_BOOTSTRAP_ENABLED=true
FITAI_BOOTSTRAP_USERNAME=admin
FITAI_BOOTSTRAP_PASSWORD=ChangeMe@123456
FITAI_BOOTSTRAP_DISPLAY_NAME=系统管理员

# ---- Admin web ----
ADMIN_WEB_PORT=8088
