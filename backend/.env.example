# 服务配置
APP_ENV=dev
# 生产/后台联调使用 MySQL；执行 admin-server Flyway 后再启动 FastAPI
DATABASE_URL=mysql+pymysql://fitai:fitai@127.0.0.1:3306/fitai?charset=utf8mb4
# 纯 App 本地开发也可继续使用 SQLite：
# DATABASE_URL=sqlite:///./fitai.db
# 后台上传教学视频的本地目录；生产建议挂载数据盘或改用 OSS/COS + CDN
MEDIA_ROOT=media

# 数据库连接池与同步路由线程池（按机器规格调整）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
THREAD_POOL_SIZE=64

# 模型：mock | deepseek | qwen | doubao
# 默认 DeepSeek；未填 LLM_API_KEY 时自动使用 Mock/规则模板。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_REASONING_EFFORT=high
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_SECONDS=90

# 视觉识别（留空则使用 Mock）
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# 美团联盟（留空则外卖接口返回 501）
MEITUAN_DEEPLINK_BASE=
MEITUAN_H5_BASE=

# 后台管理（生产必须修改）
# 开发环境未配置时默认 dev-admin-token；生产留空会直接关闭后台。
ADMIN_TOKEN=dev-admin-token
# Spring Boot 管理端 JWT 密钥；与 admin-server 的 FITAI_JWT_SECRET 保持一致。
# 配置后生产环境只接受 Spring Boot 登录后签发的短期 JWT，不再接受静态 ADMIN_TOKEN。
ADMIN_JWT_SECRET=
ADMIN_JWT_ISSUER=fitai-admin

# 认证（生产必须配置强随机 JWT_SECRET）
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Sign in with Apple 的 audience，通常是 com.fitai.app（App Bundle ID）
APPLE_CLIENT_ID=com.fitai.app

# 短信：dev 会在接口返回 dev_code；webhook 会 POST 到自定义网关
SMS_PROVIDER=dev
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# 微信/QQ 开放平台（未配置时开发环境提供模拟授权页）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_SECRET=
# 真实 OAuth 回调必须能被手机访问；留空时按请求 Host 自动推导
OAUTH_CALLBACK_BASE=
APP_CALLBACK_SCHEME=fitai

# CORS，多个用逗号分隔
CORS_ORIGINS=*
