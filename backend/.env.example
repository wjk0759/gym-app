# 服务配置
APP_ENV=dev
DATABASE_URL=sqlite:///./fitai.db
# 生产示例：postgresql+psycopg://fitai:fitai@localhost:5432/fitai

# 模型：mock | deepseek | qwen | doubao
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 视觉识别（留空则使用 Mock）
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# 美团联盟（留空则外卖接口返回 501）
MEITUAN_DEEPLINK_BASE=
MEITUAN_H5_BASE=

# CORS，多个用逗号分隔
CORS_ORIGINS=*
